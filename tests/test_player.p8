pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- test player


#include ../src/util.lua
#include ../src/class.lua
#include ../src/entity.lua
#include ../src/tile.lua
#include ../src/tile_stack.lua
#include ../src/discard_pile.lua
#include ../src/meld.lua
#include ../src/meld_stack.lua
#include ../src/hand.lua
#include ../src/player.lua
-->8
assert(discard_pile)
assert(player)
assert(meld)
assert(meld_stack)
assert(hand)
assert(tile)


cls(1)

function tn(n)
	return tile:new():set_value(n)
end

function mn(p,o,t,a) 
	return meld:new():set_origin(p or 4)
	:set_tiles(o or {tn(), tn()},t or tn(),a)
end

p = player:new():set_pos(63,56)


--hand

n = 13

tiles = {}
for i = 1,n do
	add(tiles, tn(i))
end

assert(p.hand.length == 0)

p.hand:set_tiles(tiles)

assert(p.hand.length == n)

-- meld stack

p.meld_stack:set_melds(
	{mn(),mn()}
)

assert(p.meld_stack.length == 2)

-- discard pile

local m = 14

tiles2 = {}
for i = 1,m do
	add(tiles2, tn(i))
end

p.discard_pile
:set_tiles(tiles2)
:set_riichi_i(2)

assert(p.discard_pile.length == m)




--draw
for r = 1,4 do
	p:set_rotation(r)
	:apply_tile_states():draw()
end

flip()
