pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include ../src/class.lua
#include ../src/wall.lua

cls()
wall1 = wall:new()
wall2 = wall:new()

for i = 1,5 do
	wall1:add_tile(i)
	wall2:add_tile(1)
end
for i = 1,5 do
	?wall1:get_tile()
	?wall2:get_tile()
end

?wall1.length
wall1:populate()
?#wall1.t_tiles
?wall1.length
?wall2.length

wall1:draw()
