pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	x,y = 16,64

	r = cocreate(
		function()
			for i=1,30 do
				x+=1
				yield()
			end
		end
	)
end

function _update60()
	coresume(r)
end

function _draw()
	cls()
	rect(x,y,x+10,y+10,8)
end
